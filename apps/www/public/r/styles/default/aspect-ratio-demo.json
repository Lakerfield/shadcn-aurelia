{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "aspect-ratio-demo",
  "type": "registry:example",
  "title": "Aspect Ratio Demo",
  "description": "Example: aspect-ratio-demo.",
  "registryDependencies": [
    "aspect-ratio"
  ],
  "files": [
    {
      "path": "registry/default/examples/aspect-ratio-demo.ts",
      "type": "registry:example",
      "content": "import { customElement } from 'aurelia'\nimport { UiAspectRatio } from '@/registry/default/ui/aspect-ratio'\n\nconst TEMPLATE = `\n<div class=\"w-full max-w-sm\">\n  <ui-aspect-ratio ratio=\"16/9\" class=\"bg-muted rounded-lg\">\n    <img src=\"https://images.unsplash.com/photo-1588345921523-c2dcdb7f1dcd?w=800&dpr=2&q=80\"\n         alt=\"Landscape photograph by Tobias Tullius\"\n         class=\"absolute inset-0 h-full w-full rounded-lg object-cover\">\n  </ui-aspect-ratio>\n</div>\n`\n\n@customElement({ name: 'aspect-ratio-demo', template: TEMPLATE, dependencies: [UiAspectRatio] })\nexport class AspectRatioDemo {}\n"
    }
  ]
}
